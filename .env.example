# City Connector Mobile Environment Configuration

# API Gateway base URL (Kong Gateway)
EXPO_PUBLIC_API_BASE_URL=https://api.cityconnector.transit

# Run app fully offline/without backend with MSW fixtures
EXPO_PUBLIC_USE_MOCKS=true

# Map tile style URL for MapLibre
EXPO_PUBLIC_MAP_TILE_STYLE_URL=https://demotiles.maplibre.org/style.json

# Primary transit agency timezone (used for explicit time/date calculations)
EXPO_PUBLIC_DEFAULT_CITY_TIMEZONE=Africa/Nairobi

# Realtime polling interval in milliseconds (default 20s)
EXPO_PUBLIC_REALTIME_POLL_INTERVAL_MS=20000

# Realtime staleness threshold in milliseconds (default 30s)
EXPO_PUBLIC_REALTIME_STALE_THRESHOLD_MS=30000
