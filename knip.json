{
  "$schema": "https://unpkg.com/knip@5/overview/config.schema.json",
  "entry": [
    "app/**/*.tsx",
    "app/**/*.ts",
    "app.config.ts",
    "metro.config.js",
    "babel.config.js",
    "jest.config.js"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "app/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "expo-symbols",
    "expo-constants",
    "expo-font",
    "expo-splash-screen",
    "expo-status-bar",
    "expo-web-browser",
    "react-native-web",
    "react-native-worklets",
    "react-dom"
  ]
}
