{
  "$schema": "https://unpkg.com/knip@5/overview/config.schema.json",
  "entry": [
    "app/**/*.{ts,tsx}",
    "src/api/index.ts",
    "src/components/index.ts",
    "src/test/**/*.{ts,tsx}"
  ],
  "project": ["src/**/*.{ts,tsx}", "app/**/*.{ts,tsx}"],
  "ignoreDependencies": [
    "@gorhom/bottom-sheet",
    "@shopify/flash-list",
    "react-native-unistyles",
    "lefthook",
    "expo-updates",
    "expo-glass-effect",
    "expo-web-browser",
    "babel-jest"
  ],
  "ignoreBinaries": ["maestro"],
  "rules": {
    "exports": "off",
    "types": "off"
  }
}
